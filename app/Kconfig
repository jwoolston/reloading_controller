menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

module = FEEDER_SUBSYSTEM
module-str = FEEDER_SUBSYSTEM
source "subsys/logging/Kconfig.template.log_config"

config FEEDER_FULL_SENSOR_THREAD_PRIORITY
	int "Feeder full sensor ADC measurement thread priority."
	default -1

config FEEDER_FULL_SENSOR_THRESHOLD_MV
    int "Threshold ADC mV reading which will trigger a transition in state of the feeder full sensor."
    default 1000

module = FILESYSTEM_SUBSYSTEM
module-str = FILESYSTEM_SUBSYSTEM
source "subsys/logging/Kconfig.template.log_config"

module = GUI_SUBSYSTEM
module-str = GUI_SUBSYSTEM
source "subsys/logging/Kconfig.template.log_config"

config LV_USE_FS_ZEPHYR
			bool "File system on top of Zephyr FS API"
		config LV_FS_ZEPHYR_LETTER
			int "Set an upper cased letter on which the drive will accessible (e.g. 65 for 'A')"
			default 0
			depends on LV_USE_FS_ZEPHYR
		config LV_FS_ZEPHYR_PATH
			string "Set the working directory"
			depends on LV_USE_FS_ZEPHYR
		config LV_FS_ZEPHYR_CACHE_SIZE
			int ">0 to cache this number of bytes in lv_fs_read()"
			default 0
			depends on LV_USE_FS_ZEPHYR